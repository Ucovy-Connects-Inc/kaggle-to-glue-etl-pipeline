# Kaggle configuration
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# AWS configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# S3 paths
KAGGLE_CSV_S3_PATH=s3://your-bucket/kaggle/processed/
EXISTING_CSV_S3_PATH=s3://your-bucket/existing/data.csv
OUTPUT_S3_PATH=s3://your-bucket/output/enriched/
